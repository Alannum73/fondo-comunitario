# Fondo Comunitario — variables de entorno
# Copiar a .env y completar. Nunca commitear .env real.

# Nombre de la wallet de WDK CLI usada como fondo (creada con `wdk wallet create --name <nombre>`)
WDK_WALLET_NAME=fondo-test2

# Red usada para la demo (ver `wdk network list`)
WDK_NETWORK=sepolia

# Token para depósitos/pagos del fondo (ver `wdk token list --network sepolia`)
WDK_TOKEN=usdt

# Opcional: API key del indexer de WDK, solo necesaria si se usa `wdk get history`
# https://docs.wdk.tether.io/tools/indexer-api/
WDK_INDEXER_API_KEY=

# Reglas del fondo (valores por defecto al crear un grupo nuevo; configurables por grupo en la app)
FONDO_MONTO_MAX_SINIESTRO=50
FONDO_QUORUM_DELEGADOS=2
